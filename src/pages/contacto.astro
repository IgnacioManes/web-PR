---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getContent, getWhatsappUrl } from '../lib/content';
const content = await getContent();
const email = import.meta.env.PUBLIC_CONTACT_EMAIL || 'hola@paredroja.com.ar';
const location = import.meta.env.PUBLIC_LOCATION || 'Buenos Aires, Argentina';
const endpoint = import.meta.env.PUBLIC_FORMSPREE_ENDPOINT || '';
---
<BaseLayout title="Contacto — Pared Roja" description="Consultá disponibilidad para grabar, producir o mezclar tu proyecto en Pared Roja." current="/contacto">
  <section class="page-hero">
    <p class="eyebrow">Contacto</p>
    <h1 class="display">Contanos qué<br />querés hacer<br /><em>sonar.</em></h1>
    <div class="page-hero-bottom"><span class="eyebrow">Precios bajo consulta</span><p>Cuanto más sepamos de tu proyecto, mejor podemos pensar la sesión. También podés escribirnos directamente por WhatsApp.</p></div>
  </section>

  <section class="section-pad">
    <div class="contact-grid">
      <aside class="contact-aside">
        <p class="eyebrow">Hablemos</p><h2>Tu próxima sesión puede empezar acá.</h2>
        <a class="button button-red" href={getWhatsappUrl()} target="_blank" rel="noreferrer">Abrir WhatsApp <span>↗</span></a>
        <div class="contact-links"><a href={`mailto:${email}`}><span>Email</span><b>{email}</b></a><a href="https://www.instagram.com/estudioparedroja/" target="_blank" rel="noreferrer"><span>Instagram</span><b>@estudioparedroja ↗</b></a><p><span>Ubicación</span><b>{location}</b></p></div>
      </aside>
      <form class="contact-form" action={endpoint || undefined} method="POST" data-formspree={endpoint} novalidate>
        <div class="honeypot" aria-hidden="true"><label>No completar <input name="_gotcha" tabindex="-1" autocomplete="off" /></label></div>
        <div class="form-field"><label for="name">Nombre *</label><input id="name" name="name" required autocomplete="name" /></div>
        <div class="form-field"><label for="project">Banda o proyecto</label><input id="project" name="project" /></div>
        <div class="form-field"><label for="email">Email *</label><input id="email" name="email" type="email" required autocomplete="email" /></div>
        <div class="form-field"><label for="phone">WhatsApp</label><input id="phone" name="phone" type="tel" autocomplete="tel" /></div>
        <div class="form-field"><label for="service">Servicio</label><select id="service" name="service"><option value="">Elegí una opción</option>{content.services.map((service) => <option value={service.title}>{service.title}</option>)}</select></div>
        <div class="form-field"><label for="dates">Fechas aproximadas</label><input id="dates" name="dates" placeholder="Ej. segunda quincena de octubre" /></div>
        <div class="form-field full"><label for="message">Contanos sobre el proyecto *</label><textarea id="message" name="message" required placeholder="Cantidad de músicos, referencias, etapa del proyecto y cualquier dato que nos ayude a entenderlo."></textarea></div>
        <div class="form-actions"><p class="form-status" role="status" aria-live="polite">Respondemos con disponibilidad y una propuesta.</p><button class="button button-dark" type="submit">Enviar consulta <span>→</span></button></div>
      </form>
    </div>
  </section>

  <section class="section-pad" style="padding-top:0">
    <div class="split-heading"><p class="eyebrow">Preguntas frecuentes</p><h2 class="section-title">Antes de<br /><em>reservar.</em></h2></div>
    <div class="faq-list">{content.faqs.map((faq) => <details><summary>{faq.question}</summary><p>{faq.answer}</p></details>)}</div>
  </section>

  <script is:inline define:vars={{ fallbackWhatsapp: getWhatsappUrl() }}>
    const form = document.querySelector('[data-formspree]');
    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const status = form.querySelector('.form-status');
      if (!form.checkValidity()) { form.reportValidity(); return; }
      const endpoint = form.dataset.formspree;
      if (!endpoint) { window.open(fallbackWhatsapp, '_blank', 'noopener'); if (status) status.textContent = 'Abrimos WhatsApp para continuar la consulta.'; return; }
      const button = form.querySelector('button');
      if (button) button.disabled = true;
      if (status) status.textContent = 'Enviando consulta…';
      try {
        const response = await fetch(endpoint, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
        if (!response.ok) throw new Error('No se pudo enviar');
        form.reset(); if (status) status.textContent = '¡Gracias! Recibimos tu consulta y te responderemos pronto.';
      } catch { if (status) status.textContent = 'No pudimos enviarla. Probá por WhatsApp.'; }
      finally { if (button) button.disabled = false; }
    });
  </script>
</BaseLayout>
