---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsappFloat from '../components/WhatsappFloat.astro';
import '../styles/global.css';

const {
  title = 'Pared Roja — Estudio de grabación',
  description = 'Grabación, producción, mezcla y mastering para bandas y artistas en Buenos Aires.',
  current = '',
  image = '/og.png',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site || Astro.url.origin);
const socialImage = new URL(image, Astro.site || Astro.url.origin);
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#9d181d" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/pared-roja-logo.jpg" type="image/jpeg" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{title}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org', '@type': 'RecordingStudio', name: 'Pared Roja',
      url: canonical.origin, sameAs: ['https://www.instagram.com/estudioparedroja/'],
      address: { '@type': 'PostalAddress', addressLocality: import.meta.env.PUBLIC_LOCATION || 'Buenos Aires', addressCountry: 'AR' }
    })}></script>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Header current={current} />
    <main id="contenido"><slot /></main>
    <Footer />
    <WhatsappFloat />
  </body>
</html>
