---
import { getWhatsappUrl } from '../lib/content';
const { current = '' } = Astro.props;
const links = [
  ['/', 'Inicio'],
  ['/estudio', 'El estudio'],
  ['/servicios', 'Servicios'],
  ['/trabajos', 'Trabajos'],
  ['/contacto', 'Contacto'],
];
---
<header class="site-header" data-header>
  <a class="brand" href="/" aria-label="Pared Roja, inicio">
    <img class="brand-logo" src="/pared-roja-logo.jpg" alt="" width="52" height="52" />
    <span>Pared Roja<small>Estudio de grabación</small></span>
  </a>
  <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
    <span class="sr-only">Abrir menú</span><span></span><span></span>
  </button>
  <nav id="site-nav" class="site-nav" aria-label="Navegación principal">
    {links.map(([href, label]) => <a href={href} aria-current={current === href ? 'page' : undefined}>{label}</a>)}
    <a class="button button-small" href={getWhatsappUrl()} target="_blank" rel="noreferrer">Consultar fecha</a>
  </nav>
</header>

<script>
  const header = document.querySelector('[data-header]');
  const toggle = header?.querySelector('.menu-toggle');
  toggle?.addEventListener('click', () => {
    const open = header?.classList.toggle('menu-open') ?? false;
    toggle.setAttribute('aria-expanded', String(open));
  });
  header?.querySelectorAll('.site-nav a').forEach((link) => link.addEventListener('click', () => {
    header.classList.remove('menu-open');
    toggle?.setAttribute('aria-expanded', 'false');
  }));
</script>
